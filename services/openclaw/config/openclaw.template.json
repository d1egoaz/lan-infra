{
  "env": {
    "vars": {}
  },
  "logging": {
    "level": "info",
    "consoleLevel": "info",
    "consoleStyle": "pretty",
    "redactSensitive": "tools"
  },
  "browser": {
    "enabled": false,
    "defaultProfile": "chrome"
  },
  "auth": {
    "profiles": {
      "google-gemini-cli:default": {
        "provider": "google-gemini-cli",
        "mode": "oauth"
      },
      "openai-codex:default": {
        "provider": "openai-codex",
        "mode": "oauth"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "litellm": {
        "baseUrl": "${OPENAI_BASE_URL}",
        "apiKey": "${OPENAI_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek/deepseek-chat",
            "name": "DeepSeek Chat (via LiteLLM)",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 65536,
            "maxTokens": 8192
          },
          {
            "id": "deepseek/deepseek-reasoner",
            "name": "DeepSeek Reasoner (via LiteLLM)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 65536,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai-codex/gpt-5.3-codex",
        "fallbacks": [
          "openai-codex/gpt-5.2",
          "google-gemini-cli/gemini-3-pro-preview",
          "litellm/deepseek/deepseek-reasoner"
        ]
      },
      "models": {
        "google-gemini-cli/gemini-3-pro-preview": {},
        "litellm/deepseek/deepseek-chat": {},
        "litellm/deepseek/deepseek-reasoner": {},
        "openai-codex/gpt-5.2": {
          "alias": "gpt-5.2"
        },
        "openai-codex/gpt-5.3-codex": {
          "alias": "gpt-5.3-codex"
        }
      },
      "workspace": "/home/node/.openclaw/workspace",
      "userTimezone": "America/Vancouver",
      "memorySearch": {
        "enabled": true,
        "sources": [
          "memory",
          "sessions"
        ],
        "provider": "openai",
        "remote": {
          "baseUrl": "${OPENAI_BASE_URL}",
          "apiKey": "${OPENAI_API_KEY}"
        },
        "fallback": "none",
        "model": "google/text-embedding"
      },
      "compaction": {
        "mode": "safeguard"
      },
      "thinkingDefault": "medium",
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "enabled": true,
        "provider": "perplexity",
        "apiKey": "${OPENCLAW_PERPLEXITY_API_KEY}",
        "perplexity": {
          "apiKey": "${OPENCLAW_PERPLEXITY_API_KEY}",
          "model": "${OPENCLAW_PERPLEXITY_MODEL}"
        }
      },
      "fetch": {
        "enabled": true
      }
    },
    "exec": {
      "pathPrepend": []
    }
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "channels": {
    "signal": {
      "capabilities": [],
      "httpUrl": "${OPENCLAW_SIGNAL_HTTP_URL}",
      "autoStart": true,
      "ignoreStories": true,
      "sendReadReceipts": true,
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "mediaMaxMb": 200,
      "reactionNotifications": "all",
      "actions": {
        "reactions": true
      },
      "reactionLevel": "extensive"
    }
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "remote": {
      "transport": "direct"
    },
    "nodes": {
      "allowCommands": [
        "system.which"
      ]
    }
  },
  "skills": {
    "install": {
      "nodeManager": "npm"
    }
  },
  "plugins": {
    "entries": {
      "google-gemini-cli-auth": {
        "enabled": true
      },
      "signal": {
        "enabled": true
      },
      "telegram": {
        "enabled": false
      },
      "whatsapp": {
        "enabled": false
      }
    }
  }
}
