# Portainer Backup Configuration

# Required: Your Portainer API key
# Get from: Portainer UI → My Account → API access
PORTAINER_API_KEY=your-api-key-here

# Optional: Portainer URL (default: https://portainer:9443)
# PORTAINER_URL=https://portainer.lan.diegoa.ca

# Optional: Cron schedule (default: 0 3 * * * = 3 AM daily)
# BACKUP_SCHEDULE=0 3 * * *

# Optional: Timezone (default: America/Vancouver)
# TZ=America/Vancouver

# Optional: Run backup immediately on container start (for testing)
# FIRST_RUN=true

# ===== Retention Policy (days) =====
# Daily backups: keep last 7 days
# RETENTION_DAILY=7

# Weekly backups: keep last 28 days (4 weeks)
# RETENTION_WEEKLY=28

# Monthly backups: keep last 90 days (~3 months)
# RETENTION_MONTHLY=90

# ===== Optional Hooks =====
# Commands to run before/after backup (useful for notifications)
# PRE_BACKUP_HOOK="echo 'Starting backup'"
# POST_BACKUP_HOOK="curl -s https://ntfy.sh/my-topic -d 'Portainer backup complete'"
