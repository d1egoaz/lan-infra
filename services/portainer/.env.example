# Portainer API Key (create in Portainer UI > My Account > API Keys)
PORTAINER_API_KEY=your-api-key-here

# Backup schedule (cron format) - default: daily at 3am
BACKUP_SCHEDULE=0 3 * * *

# Retention policy
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=3

# Host path for backup storage
# macOS example: /Users/Shared/backups/portainer
# Linux example: /srv/data/backups/portainer
BACKUP_HOST_PATH=/srv/data/backups/portainer

# Timezone
TZ=America/Vancouver
