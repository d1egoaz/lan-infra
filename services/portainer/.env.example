# Portainer Backup Configuration
# Copy to .env and fill in values

# Portainer URL (internal Docker network)
PORTAINER_URL=https://portainer:9443

# Portainer API Key (required - generate from Portainer UI)
PORTAINER_API_KEY=your-api-key-here

# Backup schedule (hour and minute, 24h format)
BACKUP_HOUR=3
BACKUP_MINUTE=0

# Timezone
TZ=America/Vancouver