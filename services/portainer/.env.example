# Portainer API Key (create in Portainer UI > My Account > API Keys)
PORTAINER_API_KEY=your-api-key-here

# Restic configuration (backups stored in /srv/data/backups/portainer on host)
RESTIC_PASSWORD=your-restic-password-here
# RESTIC_REPOSITORY defaults to /backups (container path)

# Backup schedule (cron format) - default: daily at 3am
BACKUP_SCHEDULE=0 3 * * *

# Retention policy
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=3

# Timezone
TZ=America/Vancouver
