# Portainer Backup with Restic
# Copy to .env and fill in values

# Portainer API authentication (choose one method)
# Option 1: API Key (recommended)
PORTAINER_API_KEY=

# Option 2: Username/Password (legacy)
# PORTAINER_USERNAME=
# PORTAINER_PASSWORD=

# Portainer URL (internal Docker network)
PORTAINER_URL=https://portainer:9443

# Restic repository configuration
# Examples:
#   /backups                          (local filesystem)
#   s3:s3.amazonaws.com/bucket-name   (S3)
#   b2:bucket-name:path               (Backblaze B2)
#   rclone:remote:path                (Rclone)
RESTIC_REPOSITORY=/backups
RESTIC_PASSWORD=

# Optional: host tag for snapshots
RESTIC_HOST=portainer-backup

# Retention policy
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=3

# Backup schedule (cron expression)
BACKUP_SCHEDULE=0 3 * * *

# Timezone
TZ=America/Vancouver

# Run backup immediately on first start (true/false)
FIRST_RUN=false