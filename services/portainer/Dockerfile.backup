FROM alpine:3.21

RUN apk add --no-cache curl jq tzdata dcron bash

# Install restic
RUN wget -qO - https://github.com/restic/restic/releases/download/v0.17.0/restic_0.17.0_linux_arm64.tar.gz | tar -xz -C /usr/local/bin restic && \
    chmod +x /usr/local/bin/restic

# Create non-root user
RUN adduser -D -s /bin/sh backup && \
    mkdir -p /backups && \
    chown backup:backup /backups

USER backup
WORKDIR /backups

# Copy backup script
COPY --chmod=755 backup-restic.sh /usr/local/bin/backup-restic.sh

# Entrypoint that sets up cron
COPY --chmod=755 entrypoint-backup.sh /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]